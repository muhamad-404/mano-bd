{
  "name": "mano-birthday",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "node scripts/lan-url.mjs && vite --host",
    "dev:https": "node scripts/lan-url.mjs https && vite --host --mode https",
    "build": "vite build",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview --host",
    "preview:mobile": "npm run build && node scripts/lan-url.mjs preview && vite preview --host",
    "deploy:manual": "gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "@tsparticles/vue3": "^4.4.0",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "phaser": "^4.2.1",
    "typed.js": "^3.0.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "gh-pages": "^6.3.0",
    "qrcode-terminal": "^0.12.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "vite": "^8.3.4"
  }
}
